---
import "../styles/global.css";
import "../styles/animations.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Portfolio of hardware, embedded, and software projects.",
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{/* Scroll-reveal hides content until observed, so it must only apply
		    when JS is actually running — otherwise a failed script leaves the
		    whole page blank. Inline and in <head> so it lands before paint. */}
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
		{/* Modals live outside <main> so the modal script can mark the page
		    behind them inert without also disabling the modal itself. */}
		<slot name="overlays" />
		<script>
			import "../scripts/reveal.ts";
			import "../scripts/modal.ts";
		</script>
	</body>
</html>
