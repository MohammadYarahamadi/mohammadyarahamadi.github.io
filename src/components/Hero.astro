---
---

<section class="hero" data-reveal>
	<div class="container">
		<p class="hero__eyebrow">Hi, I'm Mohyar</p>
		<h1 class="hero__title">
			I build embedded systems, IoT devices, and the software behind them.
		</h1>
		<p class="hero__subtitle">
			From a networked ROV to a sous vide controller to enterprise ERP work —
			I like projects that sit at the intersection of hardware, networking,
			and backend engineering.
		</p>
		<div class="hero__actions">
			<a class="button button--primary" href="#projects">See my projects</a>
			<a class="button button--ghost" href="#contact">Get in touch</a>
		</div>
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-6);
	}

	.hero__eyebrow {
		color: var(--color-accent);
		font-weight: 600;
		margin-bottom: var(--space-2);
	}

	.hero__title {
		font-size: clamp(2rem, 5vw, 3.25rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		max-width: 40ch;
	}

	.hero__subtitle {
		margin-top: var(--space-3);
		max-width: 55ch;
		color: var(--color-text-muted);
		font-size: 1.125rem;
	}

	.hero__actions {
		display: flex;
		gap: var(--space-3);
		margin-top: var(--space-5);
	}

	.button {
		display: inline-flex;
		align-items: center;
		padding: 0.75rem 1.25rem;
		border-radius: var(--radius);
		font-weight: 600;
		transition:
			transform 0.2s var(--ease-out),
			background 0.2s var(--ease-out),
			border-color 0.2s var(--ease-out);
	}

	.button:hover,
	.button:focus-visible {
		transform: translateY(-2px);
	}

	.button--primary {
		background: var(--color-accent);
		color: #04211c;
	}

	.button--primary:hover,
	.button--primary:focus-visible {
		background: var(--color-accent-strong);
	}

	.button--ghost {
		border: 1px solid var(--color-border);
		color: var(--color-text);
	}

	.button--ghost:hover,
	.button--ghost:focus-visible {
		border-color: var(--color-accent);
	}
</style>
