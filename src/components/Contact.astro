---
const email = "mohyar1380@gmail.com";
---

<section id="contact" class="contact" data-reveal>
	<div class="container">
		<h2 class="section-title">Get in touch</h2>
		<p class="contact__body">
			Have a project in mind, or want to talk hardware, embedded systems, or
			ERP work? I'd like to hear from you.
		</p>
		<a class="button button--primary" href={`mailto:${email}`}>{email}</a>
	</div>
</section>

<style>
	.contact {
		padding-block: var(--space-6);
		border-top: 1px solid var(--color-border);
	}

	.section-title {
		font-size: 1.75rem;
		letter-spacing: -0.01em;
		margin-bottom: var(--space-3);
	}

	.contact__body {
		max-width: 55ch;
		color: var(--color-text-muted);
		margin-bottom: var(--space-4);
	}

	.button {
		display: inline-flex;
		align-items: center;
		padding: 0.75rem 1.25rem;
		border-radius: var(--radius);
		font-weight: 600;
		transition: transform 0.2s var(--ease-out), background 0.2s var(--ease-out);
	}

	.button--primary {
		background: var(--color-accent);
		color: #04211c;
	}

	.button--primary:hover,
	.button--primary:focus-visible {
		transform: translateY(-2px);
		background: var(--color-accent-strong);
	}
</style>
