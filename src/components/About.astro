---
const { eyebrow = "07 · About" } = Astro.props;
const steps = [
	["Education", "Computer Engineering degree", "Foundations in digital systems, networks and programming."],
	["Engineering", "ESP32 and Raspberry Pi systems", "From an underwater ROV to an industrial drilling simulator."],
	["Sales", "Selling the websites our team built", "Finding customers and working out what they actually needed."],
	["Teaching", "Arduino for kids", "Teaching children to build and code at a robotics house."],
	["Teaching", "Sales and negotiation", "Taught sales and negotiation at college."],
	["Now", "Learning AI / LLM systems", "Working through how LLMs are built and used, and writing it up."],
];
---

<section class="j-section about" id="about" data-world="plain" data-chapter="07 · About" aria-labelledby="about-title">
	<div class="j-section__head">
		<p class="eyebrow">{eyebrow}</p>
		<h2 id="about-title">Engineer by degree, teacher by choice</h2>
		<p>
			I studied Computer Engineering and ended up where hardware meets software. I also teach
			Arduino to children at a robotics house, which keeps my explanations honest.
		</p>
	</div>
	<ol class="timeline">
		{
			steps.map(([when, title, text], i) => (
				<li class={i === steps.length - 1 ? "now" : undefined}>
					<small>{when.toUpperCase()}</small>
					<h3>{title}</h3>
					<p>{text}</p>
				</li>
			))
		}
	</ol>
</section>
