---
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container footer__inner">
		<p>&copy; {year} Mohyar · Embedded Software Engineer</p>
		<nav aria-label="Footer">
			<ul>
				<li><a href="/projects/">Projects</a></li>
				<li><a href="/#about">About</a></li>
				<li><a href="/#contact">Contact</a></li>
				<li><a href="/overview/">1-minute overview</a></li>
			</ul>
		</nav>
	</div>
</footer>

<style>
	.footer {
		position: relative;
		border-top: 1px solid var(--color-border);
		background: var(--color-bg);
	}

	.footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding-block: var(--space-4);
		color: var(--color-text-muted);
		font-size: 0.875rem;
	}

	.footer ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
	}

	.footer a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: 0.5rem;
		white-space: nowrap;
	}

	.footer a:hover {
		color: var(--color-text);
	}
</style>
