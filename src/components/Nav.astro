---
interface Props {
	/** The homepage journey: adds the chapter pill and the progress bar, and
	    lets the header take its colours from the active world. */
	journey?: boolean;
}

const { journey = false } = Astro.props;

const links = [
	// Root-relative so the links also work from project pages.
	{ href: "/projects/", label: "Projects" },
	{ href: "/#about", label: "About" },
	{ href: "/#contact", label: "Contact" },
];
---

<header class:list={["nav", { "nav--journey": journey }]}>
	{journey && <div class="nav__progress" id="j-progress" aria-hidden="true"></div>}
	<div class="nav__inner">
		<a href="/#top" class="nav__brand">mohyar<span>_</span></a>
		{
			journey && (
				<p class="nav__chapter" id="j-chapter" aria-live="polite">
					00 · Intro
				</p>
			)
		}
		<nav aria-label="Primary">
			<ul class="nav__links">
				{
					links.map((link) => (
						<li class:list={{ "nav__dup": link.label === "Contact", "nav__about": link.label === "About" }}>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
				<li class="nav__cta">
					<a href="/#contact">Get in touch</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.nav {
		--nav-fg: var(--color-text);
		--nav-acc: var(--color-accent);
		position: sticky;
		top: 0;
		z-index: 10;
		color: var(--nav-fg);
		background: color-mix(in srgb, var(--color-bg) 82%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
		transition: color 0.4s ease, background-color 0.4s ease, border-color 0.4s ease;
	}

	/* On the homepage the worlds show through; journey.ts sets the colours. */
	.nav--journey {
		position: fixed;
		inset: 0 0 auto;
		--nav-fg: var(--j-fg, var(--color-text));
		--nav-acc: var(--j-acc, var(--color-accent));
		/* solid again over the plain sections (journey.ts sets --j-nav-bg) */
		background: var(--j-nav-bg, transparent);
		backdrop-filter: none;
		border-bottom-color: transparent;
	}

	.nav__progress {
		position: absolute;
		top: 0;
		left: 0;
		height: 3px;
		width: 100%;
		transform-origin: left;
		transform: scaleX(var(--j-progress, 0));
		background: var(--nav-acc);
	}

	.nav__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: 72px;
		padding-inline: clamp(16px, 3.4vw, 48px);
	}

	.nav__brand {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font: 600 1.1rem var(--font-mono);
	}

	.nav__brand span {
		color: var(--nav-acc);
	}

	.nav__chapter {
		padding: 0.45rem 1rem;
		border: 1px solid color-mix(in srgb, var(--nav-fg) 30%, transparent);
		border-radius: 999px;
		font: 0.75rem var(--font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.nav__links {
		display: flex;
		gap: clamp(0.25rem, 1.5vw, 1rem);
		list-style: none;
	}

	.nav__links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: 0.6rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 500;
		opacity: 0.8;
		transition: opacity 0.2s ease;
	}

	.nav__links a:hover,
	.nav__links a:focus-visible {
		opacity: 1;
	}

	/* the one action every page should offer */
	.nav__cta a {
		margin-left: 0.25rem;
		white-space: nowrap;
		padding-inline: 1rem;
		border: 1px solid color-mix(in srgb, var(--nav-acc) 55%, transparent);
		color: var(--nav-acc);
		opacity: 1;
	}

	.nav__cta a:hover {
		background: color-mix(in srgb, var(--nav-acc) 12%, transparent);
	}

	/* phones: the button replaces the plain Contact link */
	@media (max-width: 520px) {
		.nav__dup {
			display: none;
		}

		.nav__links a {
			padding-inline: 0.5rem;
		}

		.nav__cta a {
			padding-inline: 0.85rem;
		}
	}

	/* small phones: About drops out (it's a scroll away on the homepage) */
	@media (max-width: 400px) {
		.nav__about {
			display: none;
		}

		.nav__cta a {
			padding-inline: 0.75rem;
		}
	}

	@media (max-width: 760px) {
		.nav__chapter {
			display: none;
		}
	}

	/* Stacked worlds scroll under the nav, so it needs a background. */
	@media (max-width: 900px) {
		.nav--journey {
			background: color-mix(in srgb, var(--j-bg, var(--color-bg)) 90%, transparent);
			backdrop-filter: blur(10px);
		}
	}
</style>
