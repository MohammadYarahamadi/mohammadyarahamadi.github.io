---
import SousVideDashboard from "./islands/SousVideDashboard";
import CameraSystemDiagram from "./islands/CameraSystemDiagram";
import SalesPipeline from "./islands/SalesPipeline";

interface Props {
	demoComponent?: string;
}

const { demoComponent } = Astro.props;
---

{demoComponent === "SousVideDashboard" && <SousVideDashboard client:visible />}
{demoComponent === "CameraSystemDiagram" && <CameraSystemDiagram client:visible />}
{demoComponent === "SalesPipeline" && <SalesPipeline client:visible />}
