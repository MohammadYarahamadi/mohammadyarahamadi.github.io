---
import type { CollectionEntry } from "astro:content";

interface Props {
	project: CollectionEntry<"projects">;
	index?: number;
}

const { project, index = 0 } = Astro.props;
const { title, summary, role, tags, period, status, hasDemo } = project.data;
const revealDelay = `${Math.min(index, 6) * 60}ms`;
---

<article
	class="card"
	data-reveal
	data-project-id={project.id}
	style={`--reveal-delay: ${revealDelay}`}
>
	<div class="card__top">
		<span class={`badge ${status === "ongoing" ? "badge--ongoing" : ""}`}>
			{status === "ongoing" ? "Current" : period}
		</span>
		{hasDemo && <span class="badge badge--demo">Live demo</span>}
	</div>
	<h3 class="card__title">{title}</h3>
	<p class="card__role">{role}</p>
	<p class="card__summary">{summary}</p>
	<ul class="card__tags">
		{tags.map((tag) => <li>{tag}</li>)}
	</ul>
	<button class="card__cta" type="button" data-open-project={project.id}>
		View details
	</button>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		padding: var(--space-4);
		background: var(--color-bg-elevated);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		transition:
			transform 0.2s var(--ease-out),
			border-color 0.2s var(--ease-out);
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: var(--color-accent);
	}

	.card__top {
		display: flex;
		gap: var(--space-2);
	}

	.badge {
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: var(--color-border);
		color: var(--color-text-muted);
		width: fit-content;
	}

	.badge--ongoing {
		background: color-mix(in srgb, var(--color-accent) 20%, transparent);
		color: var(--color-accent);
	}

	.badge--demo {
		background: color-mix(in srgb, var(--color-accent-strong) 20%, transparent);
		color: var(--color-accent-strong);
	}

	.card__title {
		font-size: 1.25rem;
		letter-spacing: -0.01em;
	}

	.card__role {
		color: var(--color-accent);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.card__summary {
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		flex-grow: 1;
	}

	.card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		list-style: none;
	}

	.card__tags li {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 0.15rem 0.55rem;
	}

	.card__cta {
		margin-top: var(--space-2);
		align-self: flex-start;
		background: none;
		border: none;
		color: var(--color-accent);
		font-weight: 600;
		font-size: 0.9375rem;
		cursor: pointer;
		padding: 0;
	}

	.card__cta:hover,
	.card__cta:focus-visible {
		text-decoration: underline;
	}
</style>
